#!/usr/bin/env xetal
## Langton's ant: on a white cell it turns right, on a black cell
## left; it flips the cell and steps forward. From two rules comes
## chaos, and then, after about 10000 steps, a "highway" the ant
## builds forever. Here the ant is arrays: its position is a mask
## with a single 1, its direction a number; no indexing, no loops,
## just whole-array steps. Run it with "xetal run
## demos/langtons-ant/langtons-ant.xtl"; it prints the state's shape,
## the board drawn with characters (black, white, the ant), and how
## many cells are black. The live page runs it frame by frame and
## pauses when the highway forms:
## https://softwarewrighter.github.io/X_eTaL-demos/langtons-ant/

## The board's size and the number of steps.
rows := 21
cols := 21
steps := 400

### One step of the ant

## u:s_tep (b, a, d): the state is a tuple, the board (0 white, 1
## black), the ant's mask (1 where it stands), and its direction (0
## up, 1 right, 2 down, 3 left), taken apart by the pattern and given
## back as a new tuple (D7, landed); d is a plain scalar now, not a
## plane carrying the same number everywhere. cell looks up the color
## under the ant (the board times its mask, summed); turn is right
## (+1) on white, left (+3, that is -1) on black; flip turns the
## cell's color over where the mask is 1; dy, dx move the mask one
## row or column, by its new direction.
u:s_tep := { (b, a, d) ->
  cell := '+ r_/ r_avel a * b
  turn := (d + 1 + 2 * cell) m_od 4
  flip := b + a * 1 - 2 * b
  dy := (1 * turn = 0) - 1 * turn = 2
  dx := (1 * turn = 3) - 1 * turn = 1
  step := dy o_-_1 dx o_-_2 a
  (flip, step, turn)
}
# -- end of the core ---------------------------------------------------

# Start: a white board, the ant in the middle facing up.
row := (o_ffsets rows) 'l_eft t_able o_ffsets cols
col := (o_ffsets rows) 'r_ight t_able o_ffsets cols
b0 := 0 * row
a0 := 1 * (row = rows d_iv 2) & col = cols d_iv 2
(b, a, d) := steps 'u:s_tep p_ower (b0, a0, 0)
s_hape b

# The board after the steps: # black, . white, A the ant.
((1 + b + 2 * a) m_in 3) s_elect ".#A"
'+ r_/ r_avel b
