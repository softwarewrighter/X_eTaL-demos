# Pipes: what every stage shares. A stage's input is one text, its
# lines each ending in a newline; l_ines numbers every character by
# the line it is on, so a stage chooses or reorders whole lines with a
# mask or a grade over those numbers, never a loop over lines.

# The end of the input: X_eTaL cannot yet tell when standard input has
# ended ([]R_EAD fails, docs/xetal-asks.md), so the stage's wrapper
# writes this line after the real input.
end := "<<xetal-end-of-input>>"
nl := f_irst "\n"
# One character 0: the mark that the input has ended, and the padding
# of short lines (it sorts before every other character).
z := 1 t_ake []U_CHAR 0

# Whether a text ends with the mark.
e_nded := { t -> (-1 t_ake t) m_atch z }

# One line of standard input with its newline; the mark at the end.
r_ead1 := { @ -> l := []R_EAD @; l m_atch end ? z; l c_at nl }

# Up to n lines (the mark at the end once the input has ended): halves
# read one after the other, so the text is copied about log n times,
# not once per line.
r_eadn := { n ->
  n <= 1 ? r_ead1 @
  a := r_eadn n d_iv 2
  e_nded a ? a
  a c_at r_eadn n - n d_iv 2
}

# Everything up to the end, n lines first, then 2n, 4n, ...
r_eadall := { n ->
  a := r_eadn n
  e_nded a ? -1 d_rop a
  a c_at r_eadall 2 * n
}

## Standard input, every line ending in a newline.
l:r_ead := { @ -> r_eadall 64 }

## Write a text to standard output as it is (no newline added); how
## many characters.
l:o_ut := { t -> t []N_PUT "/dev/stdout" }

## Each character's line number, from 1 (a newline is on the line it
## ends).
l:l_ines := { t -> 1 + '+ s_\ (t_ally t) t_ake 0 c_at 1 * t = nl }

## How many lines.
l:c_ount := { t -> '+ r_/ 1 * t = nl }

## The lines whose mask (one per line) is 1.
l:k_eep := { mask t -> ((l:l_ines t) s_elect mask) r_eplicate t }

## The lines as the rows of a matrix, each padded with character 0 to
## the longest (its newline left out).
l:m_atrix := { t ->
  ends := w_here t = nl
  starts := (t_ally ends) t_ake 1 c_at 1 + ends
  lens := ends - starts
  w := 1 m_ax 'm_ax r_/ 0 c_at lens
  inside := lens '> t_able o_ffsets w
  at := (starts '+ t_able o_ffsets w) * inside
  (at + (1 - inside) * 1 + t_ally t) s_elect t c_at z
}
