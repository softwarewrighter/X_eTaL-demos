# xetalhead [-n N]: the first N lines of standard input (10 without -n).
"p:" u_se< "Pipes"
t := p:r_ead @
# N: the digits among the arguments (n_umbers would refuse "-n").
k := f_loor f_irst (n_umbers (args m_ember? "0123456789\n") r_eplicate args) c_at 10.0
n := p:o_ut ((r_ange p:c_ount t) <= k) p:k_eep t
