#!/usr/bin/env xetal
# Julia sets and the Mandelbrot set from one function. Both iterate
# z becoming z * z + c and count the steps z stays within 2 of the
# origin. For the Mandelbrot set, c is the grid of points and z starts
# at 0; for a Julia set, z starts at the grid and c is one number,
# which scalar extension spreads over the whole grid. X_eTaL has no
# complex numbers yet, so z and c are each a real and an imaginary part.

# The view: rows and columns, the centre (cx, cy), the width w, k steps,
# and how tall a cell is for its width (2.0 for terminal characters).
rows := 22
cols := 64
cx := 0.0
cy := 0.0
w := 3.2
k := 40
aspect := 2.0

# Numbers centred on 0: 0 1 2 3 becomes -1.5 -0.5 0.5 1.5.
u:c_entred := { n -> (f_loat o_ffsets n) - (f_loat n - 1) / 2 }
# A matrix as one plane of a rank-3 array, for stacking with c_at.
u:p_lane := { m -> (1 c_at s_hape m) r_eshape m }
# -- the grid of points, by broadcasting -------------------------------
re := cx + w * (u:c_entred cols) / f_loat cols
im := cy - aspect * w * (u:c_entred rows) / f_loat cols
grid := (u:p_lane (o_ffsets rows) 'r_ight t_able re) c_at u:p_lane im 'l_eft t_able o_ffsets cols
# -- c u:i_terate z0: k steps of z * z + c from z0 ----------------------
# c and z0 each give a real and an imaginary part (1 s_elect, 2 s_elect):
# planes of the grid, or single numbers. The state adds a third plane,
# the count of steps spent inside; a point outside keeps its z.
u:i_terate := { c z0 ->
  cr := 1 s_elect c
  ci := 2 s_elect c
  s_tep := { s ->
    zr := 1 s_elect s
    zi := 2 s_elect s
    inside := f_loat 4 >= (zr * zr) + zi * zi
    a := (inside * cr + (zr * zr) - zi * zi) + (1 - inside) * zr
    b := (inside * ci + 2 * zr * zi) + (1 - inside) * zi
    (u:p_lane a) c_at (u:p_lane b) c_at u:p_lane inside + 3 s_elect s
  }
  k 's_tep p_ower z0 c_at u:p_lane 0.0 * 1 s_elect z0
}
# -- end of the core ---------------------------------------------------

s_hape grid

# A Julia set: c = -0.8 + 0.156i, the same for every point; z0 the grid.
julia := (-0.8 c_at 0.156) u:i_terate grid
s_hape julia
(1 + f_loor (9.0 * 3 s_elect julia) / f_loat k) s_elect " .:-=+*#%@"

# The Mandelbrot set from the same function: c the grid, z0 = 0.
mandel := grid u:i_terate 0.0 * grid
(1 + f_loor (9.0 * 3 s_elect mandel) / f_loat k) s_elect " .:-=+*#%@"
