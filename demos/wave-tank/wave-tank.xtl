#!/usr/bin/env xetal
# A wave tank: the wave equation on a grid. Each step, every cell moves
# towards the average of its neighbors, carrying momentum from the step
# before: next = 2 u - previous + c^2 * (neighbors - 4 u). Walls are a
# mask, a source shakes up and down, and waves spread, bend through
# slits and interfere, all as array expressions over the whole grid.

# The tank: rows and columns, the wave speed squared c2 (at most 0.5
# for a stable step), and the source's strength and frequency.
rows := 36
cols := 72
c2 := 0.3
amp := 0.5
omega := 0.5
steps := 150

# A matrix as one plane of a rank-3 array, for stacking with c_at.
u:p_lane := { m -> (1 c_at s_hape m) r_eshape m }
# -- coordinates and the sponge ----------------------------------------
# Each cell's row and column, by broadcasting. Near the edges the
# surface is damped (a sponge), so waves leave instead of wrapping around.
col := (o_ffsets rows) 'r_ight t_able o_ffsets cols
row := (o_ffsets rows) 'l_eft t_able o_ffsets cols
edge := (row m_in (rows - 1) - row) m_in col m_in (cols - 1) - col
damp := 1.0 - 0.03 * f_loat 0 m_ax 8 - edge
# -- the scene: a double slit, as masks --------------------------------
# A wall down column 30 with two gaps (the slits); the source is the
# whole of column 10, a plane wave.
slits := ((row >= 13) & row < 16) | (row >= 20) & row < 23
wall := f_loat n_ot (col = 30) & n_ot slits
src := f_loat col = 10
# -- the Laplacian: four shifted copies minus four times the center ---
u:l_ap := { x -> ((1 o_-_1 x) + (-1 o_-_1 x) + (1 o_-_2 x) + -1 o_-_2 x) - 4.0 * x }
# -- one step for every cell at once -----------------------------------
# The state is three planes: the surface now, the surface a step ago,
# and the time (the same everywhere). Walls hold the surface at 0.
u:s_tep := { s ->
  u := 1 s_elect s
  p := 2 s_elect s
  t := 3 s_elect s
  drive := amp * src * s_in omega * f_irst r_avel t
  nxt := damp * wall * ((2.0 * u) - p) + (c2 * u:l_ap u) + drive
  (u:p_lane nxt) c_at (u:p_lane u) c_at u:p_lane t + 1.0
}
# -- end of the core ---------------------------------------------------

s0 := (3 c_at rows c_at cols) r_eshape 0.0
s := steps 'u:s_tep p_ower s0
s_hape s

# The surface: = and - troughs, + and * crests, # the wall.
u := 1 s_elect s
h := f_loat 1 + f_loor 2.5 + 2.0 * (u m_ax -1.2) m_in 1.2
(f_loor (wall * h) + (1.0 - wall) * 6.0) s_elect "=- +*#"
