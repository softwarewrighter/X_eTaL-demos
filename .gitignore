# cargo (every workspace shares ./target via .cargo/config.toml)
/target/
**/target/
**/*.rs.bk

# reg-rs caches
*.tdb*

# the built site: published as the gh-pages branch (just publish), never
# tracked on main
/pages/

# trunk serve output (just serve SLUG); the published copy is pages/
demos/*/web/dist/

# agentrail raw session transcripts (large, local only)
.agentrail/sessions/*.jsonl
.agentrail-archive/*/sessions/*.jsonl

# Claude Code local state (shared slash commands may live in .claude/commands/)
.claude/*
!.claude/commands/

# editors and OS
.idea/
.vscode/
*.swp
*~
.DS_Store

# the X_eTaL clone (scripts/xetal.sh; XETAL_COMMIT is tracked), its
# binary's symlink, local scratch and demo output
/tmp/
work/
bin/xetal
